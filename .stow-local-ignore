# Re-include stow built-in defaults (a custom ignore file overrides them entirely)
\.git
\.gitignore
^/README.*

# Repo-only files — must not be symlinked into $HOME
^/setup
^/\.zshrc\.bak
^/AGENTS.md

# Per-machine Claude state dir (live session data, not shared)
^/\.claude

# Linked by hand with an absolute path: stow only makes relative links, which systemd ignores for .wants dirs
^/\.config/systemd/user/sway-session\.target\.wants
